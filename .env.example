# =========================================================================
# Next.js / Vercel environment variables
# Copy this file to `.env.local` for local dev, and set the same values in
# the Vercel project settings (Settings -> Environment Variables) for prod.
# NEVER commit the filled-in version. .env.local is gitignored.
# =========================================================================

# ---- Supabase (from Supabase dashboard -> Project Settings -> API) ----
# Safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-anon-public-key

# Server-only. Bypasses Row Level Security. NEVER prefix with NEXT_PUBLIC_,
# never import into a client component. The Next.js app technically does not
# need this (it uses the anon key + the logged-in user's session), but it is
# listed here because the Apps Script half DOES need it (set it there too).
SUPABASE_SERVICE_ROLE_KEY=YOUR-service-role-key

# ---- Anthropic (server-side only — held inside /api routes) ----
ANTHROPIC_API_KEY=sk-ant-...

# Model IDs are configurable. Defaults are sensible; override only if needed.
# Command parsing + JD summaries (need reasoning):
ANTHROPIC_MODEL_REASONING=claude-sonnet-4-6
# Email classification + thread summaries (high volume, cheap):
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# ---- Site URL (used to build magic-link redirect) ----
# Local: http://localhost:3000   Prod: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
